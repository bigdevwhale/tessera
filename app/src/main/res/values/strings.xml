    <!-- Welcome -->
    <string name="welcome_title">The same questions, year after year</string>
    <string name="welcome_text">Ask your child, yourself or your grandmother the same questions every day, week, month or birthday. Every answer is laid as a stone of coloured glass, and the years become a mosaic.</string>
    <string name="welcome_1">Answer on film, by voice or in a few words. Each question keeps its own rhythm.</string>
    <string name="welcome_2">Then look through the years: the chorus plays one question\'s answers back to back, and you watch a face and a voice grow up.</string>
    <string name="welcome_3">Everything stays on this phone. Back it up to a file whenever you like.</string>
    <string name="welcome_go">Begin</string>

